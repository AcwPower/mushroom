# Copy to /etc/mushroom-king-timer.env on the Ubuntu CVM. Never commit real values.
APP_ENV=production
APP_BASE_URL=https://timer.example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
HOST=127.0.0.1
PORT=8000
STATIC_DIR=/opt/mushroom-king-timer/dist
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mushroom_timer
DB_USER=mushroom_app
DB_PASSWORD=replace-with-a-different-long-random-password
SMS_MODE=disabled
CLAIM_TIMEOUT_MINUTES=90
CLAIM_PENALTY_MINUTES=5
